        RuleEngine.ornek_uret(ry); print(f"{YESIL}[+] Dahili üretildi{RESET}")
    re=RuleEngine(); re.dosya_yukle(ry)
    yol=os.path.join(CFG.SONUC_DIR,"kombine.txt"); t=0; g=set()
    with open(yol,"w",encoding="utf-8") as f:
        for w in b:
            for a in [w]+list(re.uygula(w)):
                if a and a not in g:
                    g.add(a); f.write(a+"\n"); t+=1
    print(f"{YESIL}[+] {t} kelime: {yol}{RESET}")
    bekle()

