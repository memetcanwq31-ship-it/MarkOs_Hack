def menu_analiz():
    temizle(); banner(); baslik("PAROLA GÜÇ ANALİZİ")
    pw=input(f"{BEYAZ}[?] Parola: {RESET}")
    if not pw: bekle(); return
    puan=0; n=[]
    U=len(pw)
    if U>=8: puan+=1
    else: n.append("En az 8 karakter")
    if U>=12: puan+=1
    if U>=16: puan+=1
    if any(c.islower() for c in pw): puan+=1
    else: n.append("Küçük harf")
    if any(c.isupper() for c in pw): puan+=1
    else: n.append("Büyük harf")
    if any(c.isdigit() for c in pw): puan+=1
    else: n.append("Rakam")
    if any(not c.isalnum() for c in pw): puan+=1
    else: n.append("Sembol")
    if pw.lower() in [w.lower() for w in WordlistMotoru.BASE_WORDS]:
        n.append("SÖZLÜK PAROLASI!"); puan=max(0,puan-2)
    sev=(f"{KIRMIZI}{KALIN}ZAYIF{RESET}" if puan<=3 else
         f"{SARI}{KALIN}ORTA{RESET}" if puan<=5 else f"{YESIL}{KALIN}GÜÇLÜ{RESET}")
    print(f"\nSeviye: {sev}  Puan: {puan}/7  Uzunluk: {U}")
    for x in n: print(f"  • {x}")
    bekle()

