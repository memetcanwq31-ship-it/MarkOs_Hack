def banner():
    print(f"""{MOR}{KALIN}
================================================================
  D R O X Y   T O O L S   v{CFG.VERSION}
  ═════════════════════════════════════════
  SÜRÜM {CFG.SURUM} — ULTIMATE | Yapımcı: {CFG.YAPIMCI}
================================================================
{RESET}""")
    durum=" | ".join(f"{k}:{YESIL}✓{RESET}" if v else f"{k}:{KIRMIZI}✗{RESET}"
                     for k,v in OPTIONAL.items())
    print(f"{CYAN}[{durum}]{RESET}")
    print(f"{KIRMIZI}[!] Yalnızca YETKİLİ lab ortamında kullanın.{RESET}\n")

def kimlik_kaynak():
    print(f"\n{BEYAZ}Kullanıcı kaynağı: [1]Tek [2]Dahili [3]Dosya{RESET}")
    us=input(f"{SARI}Seçim: {RESET}").strip()
    users=([input(f"{BEYAZ}[?] Kullanıcı: {RESET}").strip()]
           if us=="1" else
           WordlistMotoru.USERS if us=="2" else
           WordlistMotoru.dosyadan_oku(input(f"{BEYAZ}[?] Yol: {RESET}").strip()))
    print(f"\n{BEYAZ}Parola kaynağı: [1]Tek [2]Droxy üret [3]Dosya [4]Mask{RESET}")
    ps=input(f"{SARI}Seçim: {RESET}").strip()
    if ps=="1": passes=[input(f"{BEYAZ}[?] Parola: {RESET}")]
    elif ps=="2":
        kat=input(f"{BEYAZ}[?] Katman(1-3)[2]: {RESET}").strip() or "2"
        passes=list(WordlistMotoru.uret(kat))
    elif ps=="3": passes=WordlistMotoru.dosyadan_oku(
        input(f"{BEYAZ}[?] Wordlist yolu: {RESET}").strip())
    elif ps=="4":
        m=input(f"{BEYAZ}[?] Maske (örn ?u?l?l?d?d?d): {RESET}").strip()
        passes=list(MaskEngine.uret(m))
    else: passes=[]
    return [u for u in users if u],[p for p in passes if p]

def menu_saldiri():
    temizle(); banner(); baslik("SALDIRI SANTRALİ")
    for n,s in SERVISLER.items():
        print(f"  [{n}] {s['ad']:<18} {SOLUK}(port {s['port']}){RESET}")
    sec=input(f"\n{SARI}Servis: {RESET}").strip()
    if sec not in SERVISLER: bekle(); return
    sv=SERVISLER[sec]
    hedef=input(f"{BEYAZ}[?] Hedef IP: {RESET}").strip()
    if not hedef: bekle(); return
    ps=input(f"{BEYAZ}[?] Port [{sv['port']}]: {RESET}").strip()
    port=int(ps) if ps.isdigit() else sv["port"]

    # Fingerprint
    print(f"\n{MOR}[*] Parmak izi alınıyor...{RESET}")
    fp=Fingerprint.oneri(hedef,port)
    if fp["banner"]: print(f"{CYAN}[i] Banner: {fp['banner'][:90]}{RESET}")
    print(f"{CYAN}[i] Kategori: {fp['aciklama']}{RESET}")
    if fp["kimlikler"]:
        print(f"{SARI}[i] Önerilen varsayılan kimlikler:{RESET}")
        for u,p in fp["kimlikler"][:8]: print(f"    {SOLUK}{u}:{p}{RESET}")
        if input(f"{SARI}Önerilerle saldır? (e/h): {RESET}").strip().lower()=="e":
            ek={"ilk_hitte_dur":True}
            if sv["motor"]=="http_basic": ek.update(scheme="http",path="/")
            if sv["motor"]=="http_post":
                ek["scheme"]="http"
                ek["form_tanim"]=input(f"{BEYAZ}[?] Form tanımı: {RESET}").strip()
            Santral(sec,hedef,port,[u for u,p in fp["kimlikler"] if u],
                    [p for u,p in fp["kimlikler"] if p],64,5,True,ek).calistir()
            bekle(); return

    users,passes=kimlik_kaynak()
    if not users or not passes:
        print(f"{KIRMIZI}[!] Liste boş.{RESET}"); bekle(); return

    ek={"ilk_hitte_dur":True}
    if sv["motor"]=="http_basic":
        ek["scheme"]=input(f"{BEYAZ}[?] Şema [http]: {RESET}").strip() or "http"
        ek["path"]=input(f"{BEYAZ}[?] Yol [/]: {RESET}").strip() or "/"
    if sv["motor"]=="http_post":
        ek["scheme"]=input(f"{BEYAZ}[?] Şema [http]: {RESET}").strip() or "http"
        print(f"{CYAN}Format: /login.php:user=^USER^&pass=^PASS^:F=hata{RESET}")
        ek["form_tanim"]=input(f"{BEYAZ}[?] Form: {RESET}").strip()

    mod=input(f"{SARI}Mod [1=async/2=sync] [1]: {RESET}").strip() or "1"
    if mod=="1":
        c=input(f"{BEYAZ}[?] Concurrency [64]: {RESET}").strip() or "64"
        Santral(sec,hedef,port,users,passes,int(c),5,True,ek).calistir()
    else:
        t=input(f"{BEYAZ}[?] Thread [16]: {RESET}").strip() or "16"
        Santral(sec,hedef,port,users,passes,int(t),5,False,ek).calistir()
    bekle()

def menu_hash():
    temizle(); banner(); baslik("HASH KIRMA MOTORU")
    h=input(f"{BEYAZ}[?] Hash: {RESET}").strip()
    if not h: bekle(); return
    alg=HashMotoru.tespit(h)
    print(f"{CYAN}[i] Algılanan: {alg}{RESET}")
    for n,(a,_) in HashMotoru.ALGOLAR.items(): print(f"  [{n}] {a}")
    sec=input(f"{SARI}Algoritma: {RESET}").strip()
    if sec not in HashMotoru.ALGOLAR: bekle(); return
    al=HashMotoru.ALGOLAR[sec][1]

    print(f"{BEYAZ}[1]Droxy üret [2]Dosya [3]Rule [4]Mask{RESET}")
    ws=input(f"{SARI}Wordlist: {RESET}").strip()
    if ws=="1":
        kat=input(f"{BEYAZ}[?] Katman[2]: {RESET}") or "2"
        wl=list(WordlistMotoru.uret(kat))
    elif ws=="2":
        wl=WordlistMotoru.dosyadan_oku(input(f"{BEYAZ}[?] Yol: {RESET}").strip())
    elif ws=="3":
        b=WordlistMotoru.dosyadan_oku(input(f"{BEYAZ}[?] Base list: {RESET}").strip())
        ry=input(f"{BEYAZ}[?] Kural dosyası (boş=dahili): {RESET}").strip()
        if not ry:
            ry=os.path.join(CFG.RULE_DIR,"droxy_best64.rule")
            RuleEngine.ornek_uret(ry)
        re=RuleEngine(); re.dosya_yukle(ry)
        wl=[]
        for w in b: wl.append(w); wl.extend(re.uygula(w))
        wl=list(dict.fromkeys(wl))
    elif ws=="4":
        m=input(f"{BEYAZ}[?] Maske: {RESET}").strip()
        wl=list(MaskEngine.uret(m))
    else: bekle(); return

    if not wl: print(f"{KIRMIZI}[!] Liste boş.{RESET}"); bekle(); return
    print(f"\n{MOR}[*] {len(wl)} aday kırılıyor ({al.upper()})...{RESET}")
    bulunan,deneme,sure=HashMotoru.kir(h,al,wl)
    if bulunan:
        print(f"\n{YESIL}{KALIN}[+] KIRILDI! Parola: {bulunan}{RESET}")
        log_yaz(f"HASH | {al} | {bulunan}")
    else:
        print(f"\n{KIRMIZI}[-] Bulunamadı.{RESET}")
    print(f"{CYAN}[i] {deneme} deneme, {sure:.2f}sn, {deneme/sure:.0f}/sn{RESET}")
    bekle()

