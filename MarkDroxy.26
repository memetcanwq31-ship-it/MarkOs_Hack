def menu_rule():
    temizle(); banner(); baslik("KURAL MOTORU")
    b=WordlistMotoru.dosyadan_oku(input(f"{BEYAZ}[?] Base wordlist: {RESET}").strip())
    ry=input(f"{BEYAZ}[?] Kural dosyası (boş=dahili): {RESET}").strip()
