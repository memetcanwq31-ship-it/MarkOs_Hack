        sec=input(f"\n{SARI}Droxy > Seçim: {RESET}").strip()
        aksiyon={"1":menu_saldiri,"2":menu_hash,"3":menu_rule,"4":menu_mask,
                 "5":menu_fp,"6":menu_wordlist,"7":menu_tarama,
                 "8":menu_analiz,"9":menu_rapor}
        if sec=="0":
            print(f"\n{KIRMIZI}[*] Kapatılıyor.{RESET}"); sys.exit(0)
        elif sec in aksiyon: aksiyon[sec]()
        else:
            print(f"{KIRMIZI}[!] Geçersiz.{RESET}"); time.sleep(1)

if __name__=="__main__":
    CFG.hazirla()
    import warnings; warnings.filterwarnings("ignore")
    try: menu_dongusu()
    except KeyboardInterrupt:
        print(f"\n{KIRMIZI}[-] Durduruldu.{RESET}"); sys.exit(0)
    except Exception as e:
        print(f"\n{KIRMIZI}[!] Hata: {e}{RESET}"); traceback.print_exc(); sys.exit(1)
